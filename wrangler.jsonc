// Cloudflare (Workers static assets): serves this repo as the site. The only code is worker/site.js: it sends each domain's
// pages to the right one (themarines.link = HQ, terminal7.xyz = the terminal) and gives /terminal/token link previews the token's
// own share card; everything else is served straight from the files.
// The Cloudflare project's name must match "name" below.
{
  "name": "linkmarines",
  "compatibility_date": "2026-09-01",
  "main": "worker/site.js",
  // the bot, called directly (one Worker can't fetch another over its public workers.dev address)
  // keep the linkmarines.<account>.workers.dev address (listing routes below switches it off unless this says otherwise)
  "workers_dev": true,
  "preview_urls": true,
  "services": [{ "binding": "BOT", "service": "war-room-bot" }],
  // the two domains (also set in the dashboard; listed here so a deploy keeps them) and their www names, which the worker
  // redirects to the bare domain (each www has a proxied CNAME to its domain in Cloudflare DNS)
  "routes": [
    { "pattern": "terminal7.xyz", "custom_domain": true },
    { "pattern": "themarines.link", "custom_domain": true },
    { "pattern": "www.terminal7.xyz/*", "zone_name": "terminal7.xyz" },
    { "pattern": "www.themarines.link/*", "zone_name": "themarines.link" }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
