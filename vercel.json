{
  "git": {
    "deploymentEnabled": {
      "data": false,
      "claude/*": false
    }
  },
  "rewrites": [
    {
      "source": "/terminal/token",
      "destination": "/terminal/token.html"
    },
    {
      "source": "/tts/checkout",
      "destination": "/tts/checkout.html"
    }
  ],
  "redirects": [
    {
      "source": "/trending",
      "destination": "/trending/",
      "permanent": false
    },
    {
      "source": "/stream",
      "destination": "/stream/",
      "permanent": false
    },
    {
      "source": "/stream/tts",
      "destination": "/stream/?buy=tts",
      "permanent": false
    },
    {
      "source": "/tts",
      "destination": "/tts/checkout?k=t",
      "permanent": false
    },
    {
      "source": "/bridge",
      "destination": "/bridge/",
      "permanent": false
    }
  ]
}
